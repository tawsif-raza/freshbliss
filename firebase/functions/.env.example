# Copy to functions/.env.local (git-ignored). Razorpay TEST key id only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Excel sync (optional until you set up Azure; see docs/AZURE_SETUP.md).
# Leave these empty and the sync simply does nothing.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
EXCEL_DRIVE_ID=
EXCEL_ITEM_ID=
EXCEL_TABLE_NAME=OrdersTable

# Secrets go in functions/.secret.local (git-ignored), one KEY=value per line:
#   RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx      (from Razorpay: Settings > API Keys, test mode)
#   RAZORPAY_WEBHOOK_SECRET=any-long-random-string    (you choose it; paste the same value into
#                                                      the webhook form in the Razorpay dashboard)
#   GRAPH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx      (the secret VALUE from Azure; optional until Excel sync is set up)
