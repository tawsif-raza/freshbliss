# Copy to functions/.env.local (git-ignored) for the emulator. Razorpay TEST key id only.
# For a real deployment copy it to functions/.env.production instead (see ../docs/GO_LIVE.md).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# "test" (pretend money, the default) or "live" (real money). The key id above must match:
# rzp_test_... with test, rzp_live_... with live. A mismatch makes checkout refuse to run.
RAZORPAY_MODE=test

# Excel sync (optional until you set up AWS; see docs/AWS_SETUP.md).
# Leave EXCEL_S3_BUCKET empty and the sync simply does nothing.
EXCEL_S3_BUCKET=
EXCEL_S3_KEY=orders/orders.xlsx
EXCEL_AWS_REGION=ap-south-1
EXCEL_AWS_ACCESS_KEY_ID=
# EXCEL_S3_ENDPOINT is only for trying the sync against a local S3 look-alike. Leave it out.

# Secrets go in functions/.secret.local (git-ignored), one KEY=value per line:
#   RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx      (from Razorpay: Settings > API Keys, test mode)
#   RAZORPAY_WEBHOOK_SECRET=any-long-random-string    (you choose it; paste the same value into
#                                                      the webhook form in the Razorpay dashboard)
#   EXCEL_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx   (the IAM user's secret access key; optional until Excel sync is set up)
#   ERASURE_HASH_KEY=any-random-string-of-32-or-more-characters   (the "Delete my data" button refuses to run without it; see docs/GO_LIVE.md)
