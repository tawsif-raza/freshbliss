# Local development needs NOTHING here: in `next dev` the app talks to the
# Firebase emulators automatically (project "demo-freshbliss").
#
# Optional: set to "false" to run `next dev` against a real Firebase project
# (then fill in the values below).
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Required for production builds and for non-emulator development.
# These are PUBLIC web config values, not secrets. Razorpay secrets live only
# in firebase/functions and must never be added here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3 SITE key, public). Create it in the Google reCAPTCHA admin console and register it under
# Firebase console > App Check > Apps (docs/GO_LIVE.md, section 5.5). Empty is fine until the functions enforce App Check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# The public address of the shop, with no trailing slash, for example https://www.freshbliss.in
# Used for the canonical link, social-share cards, sitemap.xml and robots.txt. On Vercel it falls back to the
# project's production domain, so you only need this for a custom domain that Vercel does not know about.
NEXT_PUBLIC_SITE_URL=
