# Local development needs NOTHING here: in `next dev` the app talks to the
# Firebase emulators automatically (project "demo-freshbliss").
#
# Optional: set to "false" to run `next dev` against a real Firebase project
# (then fill in the values below).
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Required for production builds and for non-emulator development.
# These are PUBLIC web config values, not secrets. Razorpay secrets live only
# in firebase/functions and must never be added here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
